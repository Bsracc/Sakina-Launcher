<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- In dark mode, use a lighter (less opaque) scrim since the wallpaper
         is likely already dark and the settings content uses light-on-dark colors -->
    <color name="settingsDimScrim">#50000000</color>
    <!-- Brighter red for dark ink: #F22B3A measures ~4.2:1 against white ink;
         #FF5C6C holds ~5.6:1. -->
    <color name="dangerRedBright">#FF5C6C</color>
</resources>
