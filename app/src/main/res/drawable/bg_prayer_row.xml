<?xml version="1.0" encoding="utf-8"?>
<!-- Prayer list row: sunken glass with hairline, one line per prayer. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/glassSunken" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/glassHairline" />
</shape>
