<?xml version="1.0" encoding="utf-8"?>
<!--
  Mindful countdown ring: a glassActive oval that owns the centre of the full-screen
  overlay. glassActive is the near-opaque ink surface (light: dark grey; dark: white),
  and the countdown text on it MUST use @style/TextOnGlassActive (inverse ink) — the
  same pairing every active element in the glass system uses.
  A hairline keeps the ring defined against the scrim.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/glassActive" />
    <stroke
        android:width="1dp"
        android:color="?attr/glassHairline" />
</shape>
