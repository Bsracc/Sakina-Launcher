<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12+ (cloud backup / device transfer).
   The launcher configuration (main prefs + note panel) is user data worth
   preserving across reinstall/device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="app.sakinalauncher.xml" />
        <include domain="sharedpref" path="app.sakinalauncher.note_panel.xml" />
        <include domain="sharedpref" path="app.sakinalauncher.muslim_center.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="app.sakinalauncher.xml" />
        <include domain="sharedpref" path="app.sakinalauncher.note_panel.xml" />
        <include domain="sharedpref" path="app.sakinalauncher.muslim_center.xml" />
    </device-transfer>
</data-extraction-rules>
