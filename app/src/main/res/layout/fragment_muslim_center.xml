<?xml version="1.0" encoding="utf-8"?>
<!--
  Muslim Center — reworked layout for readability.

  Hierarchy:
   1. Header row (back + centred title).
   2. Prayer card: eyebrow → hero (next prayer name + big time + countdown)
      → five-prayer list (name left, time right; active row = filled pill).
   3. Section header "Dzikir" separating the two concerns.
   4. Three dhikr cards (big count, caption, label) in one symmetric row.
   5. Footer: location + source.

  Geometry: 20dp page gutter, 14dp between cards, 20dp card padding.
  Surfaces: glass token system only (bg_glass_card / bg_glass_inset / bg_glass_active).
-->
<app.sakinalauncher.ui.view.SwipeAwareScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_scrim"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <!-- Header: back on left, optically centred title (right spacer mirrors button) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:contentDescription="@string/nav_back"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/title"
                style="@style/TextLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="@string/muslim_center"
                android:textSize="24sp" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- ============================ PRAYER CARD ============================ -->
        <LinearLayout
            android:id="@+id/prayerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:gravity="center"
                android:letterSpacing="0.18"
                android:text="@string/prayer_times"
                android:textAllCaps="true"
                android:textSize="10sp" />

            <!-- Hero: next prayer, big time, countdown -->
            <LinearLayout
                android:id="@+id/nextPrayerHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nextPrayerName"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:textSize="18sp"
                    tools:text="Maghrib" />

                <TextView
                    android:id="@+id/nextPrayer"
                    style="@style/TextLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-thin"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.01"
                    android:maxLines="1"
                    android:textSize="54sp"
                    tools:text="18:08" />

                <TextView
                    android:id="@+id/nextPrayerCountdown"
                    style="@style/TextSmallLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.8"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:text="@string/next_prayer"
                    android:textAllCaps="true"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Five prayers as a vertical list: name left, time right, one line each -->
            <LinearLayout
                android:id="@+id/prayerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="vertical">

                <!-- Fajr -->
                <LinearLayout
                    android:id="@+id/subuhRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/subuhName"
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="Fajr" />

                    <TextView
                        android:id="@+id/subuhTime"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="04:39" />

                </LinearLayout>

                <!-- Dhuhr -->
                <LinearLayout
                    android:id="@+id/dzuhurRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/dzuhurName"
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="Dhuhr" />

                    <TextView
                        android:id="@+id/dzuhurTime"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="11:56" />

                </LinearLayout>

                <!-- Asr -->
                <LinearLayout
                    android:id="@+id/asharRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/asharName"
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="Asr" />

                    <TextView
                        android:id="@+id/asharTime"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="15:17" />

                </LinearLayout>

                <!-- Maghrib -->
                <LinearLayout
                    android:id="@+id/maghribRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/maghribName"
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="Maghrib" />

                    <TextView
                        android:id="@+id/maghribTime"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="17:49" />

                </LinearLayout>

                <!-- Isha -->
                <LinearLayout
                    android:id="@+id/isyaRow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_prayer_row"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/isyaName"
                        style="@style/TextSmall"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="Isha" />

                    <TextView
                        android:id="@+id/isyaTime"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textSize="15sp"
                        tools:text="19:02" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="?attr/glassHairline" />

            <!-- Location is the primary action of this card: tap to change -->
            <TextView
                android:id="@+id/location"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.78"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/set_location_placeholder"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/prayerSource"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:alpha="0.75"
                android:gravity="center"
                android:maxLines="2"
                android:textSize="12sp"
                tools:text="Calculated offline - MWL" />

        </LinearLayout>

        <!-- ============================ DZIKIR SECTION ============================ -->
        <TextView
            style="@style/TextSmallLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.85"
            android:letterSpacing="0.18"
            android:text="@string/dzikir_section_title"
            android:textAllCaps="true"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/dhikrRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/morningDhikrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/morningDhikrCount"
                    style="@style/TextDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:textSize="30sp"
                    tools:text="24" />

                <TextView
                    style="@style/TextSmallLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.6"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:text="@string/dhikr_readings_short"
                    android:textAllCaps="true"
                    android:textSize="9sp" />

                <TextView
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/dzikir_pagi"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/eveningDhikrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/eveningDhikrCount"
                    style="@style/TextDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:textSize="30sp"
                    tools:text="24" />

                <TextView
                    style="@style/TextSmallLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.6"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:text="@string/dhikr_readings_short"
                    android:textAllCaps="true"
                    android:textSize="9sp" />

                <TextView
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/dzikir_petang"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/afterPrayerDhikrCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:minHeight="128dp"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/afterPrayerDhikrCount"
                    style="@style/TextDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:textSize="30sp"
                    tools:text="13" />

                <TextView
                    style="@style/TextSmallLight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.6"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:text="@string/dhikr_readings_short"
                    android:textAllCaps="true"
                    android:textSize="9sp" />

                <TextView
                    style="@style/TextMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/muslim_after_prayer_title"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/source"
            style="@style/TextSmallLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.8"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/dzikir_source"
            android:textSize="12sp" />

    </LinearLayout>

</app.sakinalauncher.ui.view.SwipeAwareScrollView>
