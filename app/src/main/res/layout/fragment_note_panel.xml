<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_scrim"
    android:orientation="vertical">

    <!-- Tiny optional gap for Compact panel size; weight applied in code. -->
    <Space
        android:id="@+id/topSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0" />

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/productive_edge_margin"
        android:layout_marginTop="@dimen/productive_header_top"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/TextLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="@string/notes"
            android:textAlignment="viewStart"
            android:textSize="28sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <FrameLayout
                android:id="@+id/modeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/bg_segment_track"
                android:padding="4dp">

                <View
                    android:id="@+id/segmentIndicator"
                    android:layout_width="@dimen/productive_segment_tab_width"
                    android:layout_height="@dimen/productive_segment_tab_height"
                    android:background="@drawable/bg_segment_thumb" />

                <LinearLayout
                    android:id="@+id/segmentTabs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/notesTab"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/productive_segment_tab_height"
                        android:gravity="center"
                        android:minWidth="@dimen/productive_segment_tab_width"
                        android:paddingHorizontal="10dp"
                        android:text="@string/notes" />

                    <TextView
                        android:id="@+id/todoTab"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/productive_segment_tab_height"
                        android:gravity="center"
                        android:minWidth="@dimen/productive_segment_tab_width"
                        android:paddingHorizontal="10dp"
                        android:text="@string/todo" />

                    <TextView
                        android:id="@+id/timerTab"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/productive_segment_tab_height"
                        android:gravity="center"
                        android:minWidth="@dimen/productive_segment_tab_width"
                        android:paddingHorizontal="10dp"
                        android:text="@string/timer" />

                    <TextView
                        android:id="@+id/widgetsTab"
                        style="@style/TextSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/productive_segment_tab_height"
                        android:gravity="center"
                        android:minWidth="@dimen/productive_segment_tab_width"
                        android:paddingHorizontal="10dp"
                        android:text="@string/widgets" />

                </LinearLayout>

            </FrameLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp"
            android:requiresFadingEdge="vertical" />

        <TextView
            android:id="@+id/emptyState"
            style="@style/TextSmallLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.78"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/no_notes_yet"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/timerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/productive_timer_ring"
                android:layout_height="@dimen/productive_timer_ring">

                <app.sakinalauncher.ui.view.CircularTimerView
                    android:id="@+id/timerProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timerValue"
                        style="@style/TextLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="25:00"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/timerStart"
                        style="@style/TextOnGlassActive"
                        android:layout_width="112dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_timer_start_button"
                        android:drawablePadding="7dp"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="@string/start"
                        app:drawableStartCompat="@drawable/ic_play"
                        app:drawableTint="?attr/primaryInverseColor" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/timerControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/timerPause"
                    style="@style/TextSmallBold"
                    android:layout_width="92dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:text="@string/pause" />

                <TextView
                    android:id="@+id/timerReset"
                    style="@style/TextSmallBold"
                    android:layout_width="92dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_glass_inset"
                    android:gravity="center"
                    android:text="@string/reset" />

            </LinearLayout>

            <TextView
                android:id="@+id/timerHint"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0.62"
                android:gravity="center"
                android:text="@string/tap_timer_to_set_duration" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/productive_edge_margin"
            android:visibility="gone">

            <TextView
                android:id="@+id/addWidgetButton"
                style="@style/TextOnGlassActive"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_timer_start_button"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/add_widget" />

            <TextView
                android:id="@+id/widgetsHint"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/long_press_to_remove_widget" />

            <ScrollView
                android:id="@+id/widgetsScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/widgetsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />
            </ScrollView>

            <TextView
                android:id="@+id/widgetsEmpty"
                style="@style/TextSmallLight"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:alpha="0.78"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/no_widgets_yet"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

    <!-- Single bottom slot so composer and selection bar do not stack. -->
    <FrameLayout
        android:id="@+id/bottomChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/productive_edge_margin"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_glass_inset"
            android:gravity="center_vertical"
            android:minHeight="@dimen/productive_composer_min_height"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/input"
                style="@style/TextMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/write_note"
                android:imeOptions="actionSend|flagNoEnterAction"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="2000"
                android:maxLines="4"
                android:minLines="1"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp"
                android:textAlignment="viewStart"
                android:textColorHint="?attr/primaryColorTrans50" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_note_send_button"
                android:contentDescription="@string/send"
                android:padding="12dp"
                android:src="@drawable/ic_send" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/noteActionBarScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_note_action_bar"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/noteActionBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/noteActionDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_note_action_button"
                    android:contentDescription="@string/delete_note"
                    android:padding="13dp"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/dangerColor" />

                <TextView
                    android:id="@+id/noteActionSelectAll"
                    style="@style/TextSmallBold"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_note_count_pill"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="@string/select_all"
                    android:textColor="?attr/primaryInverseColor" />

                <TextView
                    android:id="@+id/noteSelectionCount"
                    style="@style/TextSmallBold"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_note_count_pill"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="?attr/primaryInverseColor" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/noteActionEdit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_note_action_button"
                    android:contentDescription="@string/edit_note"
                    android:padding="13dp"
                    android:src="@drawable/ic_rename"
                    app:tint="?attr/primaryColor" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/noteActionCopy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_note_action_button"
                    android:contentDescription="@string/copy"
                    android:padding="13dp"
                    android:src="@drawable/ic_copy"
                    app:tint="?attr/primaryColor" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/noteActionDone"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_note_action_button"
                    android:contentDescription="@string/note_done"
                    android:padding="13dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/primaryColor" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/noteActionClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_note_action_button"
                    android:contentDescription="@string/close"
                    android:padding="13dp"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/primaryColor" />

            </LinearLayout>
        </HorizontalScrollView>
    </FrameLayout>

</LinearLayout>