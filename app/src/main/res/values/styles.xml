<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges
        </item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:colorEdgeEffect">@android:color/transparent</item>

        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!--        <item name="android:enforceStatusBarContrast">false</item>-->
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <!--        <item name="android:windowTranslucentStatus">false</item>-->
        <!--        <item name="android:windowTranslucentNavigation">true</item>-->

        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@android:color/darker_gray</item>
        <item name="colorAccent">@color/black</item>

        <item name="primaryColor">@color/black</item>
        <item name="primaryInverseColor">@color/blackInverse</item>
        <item name="dangerColor">@color/dangerRed</item>
        <item name="primaryTextShadowColor">@color/blackInverseTrans30</item>
        <item name="primaryColorTrans50">@color/blackTrans50</item>
        <item name="primaryColorTrans80">@color/blackTrans80</item>
        <item name="primaryColorInverseTrans50">@color/blackInverseTrans50</item>
        <item name="primaryColorInverseTrans80">@color/blackInverseTrans80</item>
        <item name="primaryColorInverseTrans90">@color/blackInverseTrans90</item>
        <item name="primaryShadeColor">@color/blackInverseTrans10</item>
        <item name="primaryShadeDarkColor">@color/blackInverseTrans25</item>
        <item name="dialogShadeColor">@color/blackInverseTrans50</item>

        <!-- Frosted glass surfaces (light wallpaper -> dark ink) -->
        <item name="glassScrim">@color/scrimOnLight</item>
        <item name="homeWashTop">@color/homeWashTopOnLight</item>
        <item name="homeWashFloor">@color/homeWashFloorOnLight</item>
        <item name="glassSunken">@color/glassSunkenOnLight</item>
        <item name="glassRaised">@color/glassRaisedOnLight</item>
        <item name="glassActive">@color/glassActiveOnLight</item>
        <item name="glassHairline">@color/hairlineOnLight</item>

    </style>

    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@anim/fade_enter</item>
        <item name="android:windowExitAnimation">@anim/fade_exit</item>
    </style>

    <!--
      Zero min-width so Productive dialog width scale (70–100%) is not crushed by
      the platform Dialog theme (which often forces ~80%+ of the screen).
    -->
    <style name="AppDialogTheme" parent="Theme.AppCompat.Dialog">
        <item name="android:windowMinWidthMajor">0%</item>
        <item name="android:windowMinWidthMinor">0%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
    </style>

    <style name="AppSearchText" parent="Widget.AppCompat.SearchView">
        <item name="android:maxLength">200</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColor">?attr/primaryColor</item>
        <item name="android:editTextColor">?attr/primaryColor</item>
        <item name="android:textColorHint">?attr/primaryColor</item>
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:inputType">textCapSentences|textNoSuggestions</item>
        <item name="android:cursorVisible">false</item>
    </style>

    <style name="TextDefault" parent="@android:style/TextAppearance.Large">
        <item name="android:textColor">@drawable/text_colors_default</item>
        <item name="android:textColorHint">?attr/primaryColorTrans80</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <!--
          Legibility halo, not an emboss: offset 0 so text never looks stamped or
          raised. A launcher draws over arbitrary wallpaper, so a soft same-axis
          glow is what keeps text readable without faking depth.
        -->
        <item name="android:shadowColor">?attr/primaryTextShadowColor</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">1.5</item>
    </style>

    <style name="TextLarge" parent="TextDefault">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textSize">@dimen/text_large</item>
    </style>

    <style name="TextMedium" parent="TextDefault">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextSmall" parent="TextDefault">
        <item name="android:textSize">@dimen/text_small</item>
    </style>

    <style name="TextSmallBold" parent="TextSmall">
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <!--
      Text that sits on an ?attr/glassActive fill. glassActive is near-opaque ink of
      the SAME hue as primaryColor, so a label left at primaryColor is invisible
      (white on white in dark mode, black on black in light mode). Flip to inverse
      ink and drop the legibility halo — a halo over a solid fill reads as an emboss.
    -->
    <style name="TextOnGlassActive" parent="TextSmallBold">
        <item name="android:textColor">?attr/primaryInverseColor</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:shadowColor">@android:color/transparent</item>
    </style>

    <style name="TextLargeOnGlassActive" parent="TextLarge">
        <item name="android:textColor">?attr/primaryInverseColor</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:shadowColor">@android:color/transparent</item>
    </style>

    <!--
      Home-screen text: the app labels, screen time, and anything else drawn straight
      onto the user's wallpaper below the clock scrim.

      These get a much stronger legibility halo than @style/TextDefault. The base halo
      (radius 1.5, inverse ink at 30%) is tuned for text on a glass panel, where the
      panel already carries the contrast. On the home screen there is no panel, and a
      wallpaper that fights the theme takes the labels to 1.30:1 — measured, light theme
      over a dark wallpaper. A wider, denser halo is what Android and iOS both use for
      home-screen icon labels, and it costs nothing when the wallpaper is friendly.

      This is a halo, not an emboss: offset stays 0 on both axes.
    -->
    <style name="TextHomeLabel" parent="TextLarge">
        <item name="android:shadowColor">?attr/primaryColorInverseTrans80</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <style name="TextHomeMeta" parent="TextSmall">
        <item name="android:shadowColor">?attr/primaryColorInverseTrans80</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">6</item>
    </style>

    <!--
      The home clock and date. Same halo as the app labels, for the same reason: they sit
      on bare wallpaper. The clock is 60sp so it only needs 3:1, but on this wallpaper's
      bright upper third it measured 3.94:1 on tint alone and looked washed out — the
      halo takes it clear without thickening the wash, which is what was crushing the
      wallpaper's texture in earlier iterations.
    -->
    <style name="TextHomeClock" parent="TextDefault">
        <item name="android:shadowColor">?attr/primaryColorInverseTrans80</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">8</item>
    </style>

    <!-- Subtle section header for Settings cards: smaller, semibold, spaced -->
    <style name="TextSectionTitle" parent="TextSmall">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">?attr/primaryColorTrans80</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextSmallLight" parent="TextSmall">
        <item name="android:fontFamily">@font/poppins_light</item>
        <item name="android:textColor">@drawable/text_colors_light</item>
    </style>

    <!-- Arabic / Quran typography -->
    <style name="TextArabic" parent="TextDefault">
        <item name="android:fontFamily">@font/quran_arabic</item>
        <item name="android:textColor">@drawable/text_colors_default</item>
    </style>

</resources>
